  "manual_mlp_epochs": 80,
  "manual_mlp_batch_size": 32,
  "base_dir": ".",
  "models_dir": "models",
  "records_dir": "records",
  "datasets_dir": "datasets",
  "cache_dir": "cache",
  "reports_dir": "reports",
  "logs_dir": "logs",
  "exports_dir": "exports",
  "database_dir": "database",
  "server_url": "http://127.0.0.1:8000",
  "server_dir": "server"
