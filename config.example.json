{
  "theme": "system",
  "sample_rate": 16000,
  "mono": true,
  "min_train_duration_sec": 3.0,
  "max_segment_duration_sec": 10.0,
  "record_duration_sec": 5,
  "test_size": 0.3,
  "hyperparameter_mode": "quality",
  "parameter_mode": "auto",
  "training_models": [
    "SVM",
    "MLP",
    "Random Forest",
    "Ансамбль SVM + MLP",
    "Ансамбль SVM + RandomForest",
    "Ансамбль MLP + RandomForest",
    "Ансамбль SVM + MLP + RandomForest"
